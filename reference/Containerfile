# Mehrstufiger Build: das schwere Node-Image baut, das schlanke nginx-Image liefert aus.
# Nur die zweite Stufe landet im Ergebnis - node_modules und Quelltext bleiben draussen.

FROM docker.io/library/node:24-alpine AS build
WORKDIR /app

# Erst nur die Manifeste kopieren. Aendert sich nur der Quelltext, bleibt die
# npm-ci-Schicht im Cache und die Installation wird uebersprungen.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM docker.io/library/nginx:1.29-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
